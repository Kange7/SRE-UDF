ninja_required_version = 1.3
cxx = c++
nvcc = /data0/software/cuda/11.8.0/bin/nvcc

cflags = -pthread -B /data1/home/chenym/.conda/envs/YMEnv1/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /data1/home/chenym/.conda/envs/YMEnv1/include -fPIC -O2 -isystem /data1/home/chenym/.conda/envs/YMEnv1/include -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /data1/home/chenym/.conda/envs/YMEnv1/include -I/data1/home/chenym/.conda/envs/YMEnv1/targets/x86_64-linux/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /data1/home/chenym/.conda/envs/YMEnv1/include -I/data1/home/chenym/.conda/envs/YMEnv1/targets/x86_64-linux/include -fPIC -I/data1/home/chenym/.conda/envs/YMEnv1/lib/python3.8/site-packages/torch/include -I/data1/home/chenym/.conda/envs/YMEnv1/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/data1/home/chenym/.conda/envs/YMEnv1/lib/python3.8/site-packages/torch/include/TH -I/data1/home/chenym/.conda/envs/YMEnv1/lib/python3.8/site-packages/torch/include/THC -I/data0/software/cuda/11.8.0/include -I/data1/home/chenym/.conda/envs/YMEnv1/include/python3.8 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=chamfer -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/data1/home/chenym/.conda/envs/YMEnv1/lib/python3.8/site-packages/torch/include -I/data1/home/chenym/.conda/envs/YMEnv1/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/data1/home/chenym/.conda/envs/YMEnv1/lib/python3.8/site-packages/torch/include/TH -I/data1/home/chenym/.conda/envs/YMEnv1/lib/python3.8/site-packages/torch/include/THC -I/data0/software/cuda/11.8.0/include -I/data1/home/chenym/.conda/envs/YMEnv1/include/python3.8 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=chamfer -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=sm_86 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /data1/home/chenym/CAP-UDF/extensions/chamfer_dist/build/temp.linux-x86_64-cpython-38/chamfer.o: cuda_compile /data1/home/chenym/CAP-UDF/extensions/chamfer_dist/chamfer.cu
build /data1/home/chenym/CAP-UDF/extensions/chamfer_dist/build/temp.linux-x86_64-cpython-38/chamfer_cuda.o: compile /data1/home/chenym/CAP-UDF/extensions/chamfer_dist/chamfer_cuda.cpp






